{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/build-config.ts",
    "scripts/build-config.test.ts",
    "scripts/catalog.ts",
    "scripts/skills-source.ts",
    "scripts/downloads.ts",
    "scripts/environment.test.ts",
    "scripts/downloads.test.ts",
    "scripts/academy-index.ts",
    "scripts/guide-images.ts",
    "scripts/guide-index.ts",
    "scripts/image-size.ts",
    "scripts/image-size.test.ts",
    "scripts/index-html.ts",
    "scripts/intervals.ts",
    "scripts/intervals.test.ts",
    "scripts/trainings.ts",
    "scripts/trainings.test.ts",
    "scripts/publish-files.test.ts",
    "scripts/publish-gitlab.ts",
    "scripts/publish-gitlab.test.ts",
    "scripts/publish-pending.ts",
    "scripts/publish-pending.test.ts",
    "scripts/publish-request.test.ts",
    "scripts/login-preview.ts",
    "scripts/markdown-pages.ts",
    "scripts/precompress.ts",
    "scripts/precompress.test.ts",
    "scripts/service-yaml.test.ts",
    "scripts/write-build-env.test.ts",
    "scripts/ci-rules.test.ts",
    "scripts/skills-source.test.ts",
    "scripts/clone-skills.test.ts",
    "scripts/structure.test.ts",
    "scripts/motion-tokens.test.ts",
    "e2e"
  ]
}
