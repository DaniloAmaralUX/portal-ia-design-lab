{
  "name": "portal-ia",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Pitang's internal AI portal: the Academy, the Method and the catalog of Pitang skills for Claude Code",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/precompress.ts",
    "start": "node --env-file-if-exists=.env bff/index.ts",
    "lint": "eslint src bff e2e scripts/*.ts *.config.ts *.config.mjs",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && node scripts/precompress.ts && playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "iron-session": "^9.0.1",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24.12"
  }
}
